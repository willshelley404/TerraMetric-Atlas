# ─────────────────────────────────────────────────────────────────────────────
# .Renviron.example  →  Copy to .Renviron and fill in your keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Data APIs ─────────────────────────────────────────────────────────────────
# FRED (Free) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# BLS (Free) — https://www.bls.gov/developers/home.htm
BLS_API_KEY=your_bls_api_key_here

# U.S. Census (Free) — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# NewsAPI (free dev plan = localhost only) — https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# MediaStack (free: 500 req/mo, works on any server) — https://mediastack.com/signup/free
# Recommended for Posit Connect / cloud deployments
MEDIASTACK_API_KEY=your_mediastack_key_here

# ── LLM Providers (only one required) ────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/apikey  (free tier via AI Studio, default)
# Models: gemini-3.1-flash-lite (fast, reliable, default), gemini-3.7-flash (heavier)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — https://console.groq.com  (fastest free tier, alternative)
# Models: openai/gpt-oss-120b (best quality), qwen/qwen3.6-27b, openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# ── Provider override (optional — auto-detected if not set) ──────────────────
# Values: "gemini", "groq"
LLM_PROVIDER=gemini

# ── News cache ────────────────────────────────────────────────────────────────
# Leave blank → uses ./cache/ (auto-created, works locally)
# Shiny Server: ECONPULSE_CACHE_DIR=/var/shiny-server/econpulse/cache
# Posit Connect: ECONPULSE_CACHE_DIR=/home/rstudio/econpulse_cache
ECONPULSE_CACHE_DIR=
